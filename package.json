{
	"name": "oh-my-tldraw",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"description": "Oh My tldraw: an offline tldraw canvas with an AI agent, node pipelines and branching chat.",
	"scripts": {
		"dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
		"dev:server": "tsx watch --clear-screen=false server/index.ts",
		"dev:web": "vite",
		"build": "vite build",
		"start": "NODE_ENV=production tsx server/index.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run",
		"build:desktop": "vite build && node scripts/build-electron.mjs",
		"desktop": "npm run build:desktop && electron .",
		"dist": "npm run build:desktop && electron-builder --publish never",
		"build:mygo": "vite build && node scripts/build-mygo.mjs"
	},
	"devDependencies": {
		"@ai-sdk/anthropic": "^2.0.80",
		"@ai-sdk/google": "^2.0.74",
		"@ai-sdk/openai": "^2.0.106",
		"@ai-sdk/openai-compatible": "^1.0.30",
		"@fontsource/inter": "^5.3.0",
		"@hono/node-server": "^1.19.0",
		"@tldraw/assets": "5.5.2",
		"@tldraw/tlschema": "5.5.2",
		"@types/node": "^22.15.31",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@types/sql.js": "^1.4.11",
		"@vitejs/plugin-react": "^6.0.1",
		"ai": "^5.0.194",
		"best-effort-json-parser": "^1.1.3",
		"classnames": "^2.5.1",
		"concurrently": "^9.2.0",
		"echarts": "^6.1.0",
		"electron": "^44.5.1",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.28.2",
		"hono": "^4.9.0",
		"mermaid": "^12.1.0",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.4.2",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"sucrase": "^3.35.1",
		"tldraw": "5.5.2",
		"tsx": "^4.20.0",
		"typescript": "^5.8.3",
		"vite": "^8.0.16",
		"vitest": "^4.0.0",
		"zod": "^4.1.8"
	},
	"main": "dist-electron/main.cjs",
	"author": "jstdlee",
	"homepage": "https://github.com/jstdlee/tldraw-ai-canvas",
	"dependencies": {
		"@electric-sql/pglite": "^0.5.8",
		"react-data-grid": "^7.0.0-beta.61",
		"sql.js": "^1.14.2"
	}
}
