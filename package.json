{
	"name": "tldraw-ai-canvas",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Offline tldraw canvas with an AI agent, node pipelines and branching chat, using your own AI providers.",
	"scripts": {
		"dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
		"dev:server": "tsx watch --clear-screen=false server/index.ts",
		"dev:web": "vite",
		"build": "vite build",
		"start": "NODE_ENV=production tsx server/index.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^2.0.80",
		"@ai-sdk/google": "^2.0.74",
		"@ai-sdk/openai": "^2.0.106",
		"@ai-sdk/openai-compatible": "^1.0.30",
		"@fontsource/inter": "^5.3.0",
		"@hono/node-server": "^1.19.0",
		"@tldraw/assets": "5.5.2",
		"@tldraw/tlschema": "5.5.2",
		"@types/qrcode": "^1.5.6",
		"ai": "^5.0.194",
		"best-effort-json-parser": "^1.1.3",
		"classnames": "^2.5.1",
		"hono": "^4.9.0",
		"mermaid": "^12.1.0",
		"qrcode": "^1.5.4",
		"radix-ui": "^1.4.2",
		"react": "^19.2.1",
		"react-dom": "^19.2.1",
		"react-markdown": "^10.1.0",
		"remark-gfm": "^4.0.1",
		"tldraw": "5.5.2",
		"tsx": "^4.20.0",
		"zod": "^4.1.8"
	},
	"devDependencies": {
		"@types/node": "^22.15.31",
		"@types/react": "^19.2.7",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"concurrently": "^9.2.0",
		"typescript": "^5.8.3",
		"vite": "^8.0.16",
		"vitest": "^4.0.0"
	}
}
